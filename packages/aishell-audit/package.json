{
  "name": "@huaweidevtools/aishell-dsh-audit",
  "description": "Audit trail service for aishell DSH plugins — records non-conversational actions (permission grants, account changes) to the Host log",
  "version": "0.0.36",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huawei-developers/aishell-dsh-plugins.git",
    "directory": "packages/aishell-audit"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:bundle": "tsdown",
    "prepublishOnly": "node ../../scripts/check-packages.mjs --prepublish --only aishell-audit"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "tsdown": "^0.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@huaweidevtools/aishell-dsh-credentials-store": "workspace:*"
  }
}
