{
  "name": "@huaweidevtools/aishell-dsh-deploy",
  "description": "Huawei Cloud infrastructure tools for DSH — Terraform, OpenAPI, resource inventory, cost estimates",
  "version": "0.0.21",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusheng-g/aishell-dsh-plugins.git",
    "directory": "packages/aishell-deploy"
  },
  "type": "module",
  "scripts": {
    "build:bundle": "node ../../scripts/write-deploy-version.mjs && tsdown && node ../../scripts/build-deploy-data.mjs",
    "prepublishOnly": "node ../../scripts/check-packages.mjs --prepublish --only aishell-deploy"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/data/**/*",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@huaweidevtools/aishell-dsh-credentials-store": "workspace:*",
