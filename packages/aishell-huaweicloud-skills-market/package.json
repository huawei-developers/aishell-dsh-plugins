{
  "name": "@huaweidevtools/aishell-dsh-huaweicloud-skills-market",
  "description": "Browse and install Huawei Cloud's official agent skills from inside AI Shell — a Plugins-page tab over the huaweicloud/huaweicloud-skills catalogue",
  "version": "0.0.36",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huawei-developers/aishell-dsh-plugins.git",
    "directory": "packages/aishell-huaweicloud-skills-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:bundle": "tsdown",
    "prepublishOnly": "node ../../scripts/check-packages.mjs --prepublish --only aishell-huaweicloud-skills-market"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "isomorphic-git": "^1.44.17",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.10.0",
    "typescript": "^5.7.0"
  }
}
