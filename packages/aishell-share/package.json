{
  "name": "@huaweidevtools/aishell-dsh-share",
  "description": "Shared AI Shell sessions — the aishell://share link family and its preview",
  "version": "0.0.36",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huawei-developers/aishell-dsh-plugins.git",
    "directory": "packages/aishell-share"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:bundle": "node ../../scripts/write-share-version.mjs && tsdown",
    "prepublishOnly": "node ../../scripts/check-packages.mjs --prepublish --only aishell-share"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@huaweidevtools/aishell-dsh-deeplink": "workspace:*",
    "immer": "^10.1.3",
    "zustand": "~4.5.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1 || 0.2.2-rc.2 || 0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.10.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ]
}
